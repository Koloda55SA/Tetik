# Firebase Web App config (Project settings → General → Your apps → Web app)
# Эти значения НЕ секретные (публичный клиентский конфиг), но храним в .env для гибкости окружений
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL Cloudflare Worker "tetik-engine" (после деплоя, например https://tetik-engine.<account>.workers.dev)
VITE_ENGINE_URL=
